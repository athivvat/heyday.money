# Copy to .env.compose, then fill in the empty values.
# Generate each secret independently: openssl rand -hex 32
# Use a hex password here because Compose includes it in DATABASE_URL.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

APP_PORT=3000
# Use 0.0.0.0 to make the website reachable from other devices on your LAN.
# Desktop sign-in over a LAN address still requires HTTPS (or an SSH tunnel).
APP_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
CLOUD_SYNC_ENABLED=false
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_LEGACY_PRICE_IDS=
STRIPE_TRIAL_DAYS=0
STRIPE_PORTAL_CONFIGURATION_ID=
# Match APP_PORT if you change it. Public deployments must use HTTPS.
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
AUTH_EMAIL_FROM=Heyday Money <signin@example.com>

# Beta login uses email codes only. Google and Apple are disabled.

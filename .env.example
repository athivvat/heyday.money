# Server-only variables. Configure secrets in Railway, never in VITE_* variables.
DATABASE_URL=postgresql://user:password@localhost:5432/heyday
BETTER_AUTH_URL=http://localhost:3000
# Generate a high-entropy secret (at least 32 characters).
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=Heyday Money <account@heyday.money>

# Beta login uses email codes only. Google and Apple are disabled.
# Enable only after testing; individual accounts still require a server-side grant.
CLOUD_SYNC_ENABLED=false

# Website-only subscription management. Keep disabled until Stripe is configured.
STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Fixed recurring THB prices: monthly and/or yearly. Never VITE_*.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Keep replaced Price IDs here so existing subscribers retain access.
STRIPE_LEGACY_PRICE_IDS=
# No trial until a duration is chosen; once per account, card required.
STRIPE_TRIAL_DAYS=0
# Optional; otherwise the default portal config is used. Cancel at period end.
STRIPE_PORTAL_CONFIGURATION_ID=
